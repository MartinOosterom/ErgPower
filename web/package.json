{
  "name": "ergpower-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ErgPower browser viewer — a configurable, widget-based dashboard for live Concept2 PM5 data, built on the /api/v1 contract.",
  "scripts": {
    "gen": "openapi-typescript ../api/openapi.yaml -o src/api/schema.d.ts",
    "dev": "vite",
    "build": "npm run gen && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "openapi-fetch": "^0.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^1.5.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-grid-layout": "^1.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "fsevents@2.3.3": true
  }
}
